<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: #F4F6F5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestao.agro.controller.PestelController">
   <children>
      <!-- CABEÇALHO E SELEÇÃO DE ENTIDADE -->
      <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 5, 0, 0, 2);">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label text="Análise do Ambiente Externo (Matriz PESTEL)" textFill="#1e3a2f">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Separator orientation="VERTICAL" />
                  <Label style="-fx-font-weight: bold;" text="Alvo da Avaliação:*" />
                  <RadioButton fx:id="rbTipoOrg" mnemonicParsing="false" selected="true" text="Cooperativa / Associação">
                     <toggleGroup>
                        <ToggleGroup fx:id="grpTipoAlvo" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="rbTipoProd" mnemonicParsing="false" text="Produtor Rural" toggleGroup="$grpTipoAlvo" />
                  
                  <HBox alignment="CENTER_RIGHT" spacing="15.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lblResumoOportunidades" style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-padding: 4 10; -fx-background-radius: 12; -fx-font-weight: bold;" text="0 Oportunidades" />
                        <Label fx:id="lblResumoAmeacas" style="-fx-background-color: #FFEBEE; -fx-text-fill: #C62828; -fx-padding: 4 10; -fx-background-radius: 12; -fx-font-weight: bold;" text="0 Ameaças" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <GridPane hgap="12.0" vgap="10.0">
              <columnConstraints>
                <ColumnConstraints minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="350.0" />
                <ColumnConstraints minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="250.0" />
              </columnConstraints>
              <children>
                 <Label fx:id="lblEntidadeAlvo" text="Organização:*" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                 <ComboBox fx:id="cbEntidadeAlvo" maxWidth="1.7976931348623157E308" promptText="Selecione a entidade..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                 <Label text="Consultor:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                 <TextField fx:id="txtConsultor" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="0" />
              </children>
            </GridPane>
         </children>
      </VBox>

      <!-- FORMULÁRIO DE ENTRADA DO FATOR PESTEL -->
      <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 4, 0, 0, 1);">
         <children>
            <Label text="Registro de Fator Macroeconômico / Setorial" textFill="#1e3a2f">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            
            <GridPane hgap="12.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="10.0" prefWidth="120.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="220.0" />
                  <ColumnConstraints minWidth="10.0" prefWidth="120.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="220.0" />
               </columnConstraints>
               <children>
                  <Label text="Dimensão PESTEL:*" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <ComboBox fx:id="cbDimensaoPestel" maxWidth="1.7976931348623157E308" promptText="Selecione a dimensão..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                  <Label text="Classificação:*" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <HBox alignment="CENTER_LEFT" spacing="15.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                     <children>
                        <RadioButton fx:id="rbOportunidade" mnemonicParsing="false" selected="true" text="Oportunidade">
                           <toggleGroup>
                              <ToggleGroup fx:id="grpTipoFator" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbAmeaca" mnemonicParsing="false" text="Ameaça" toggleGroup="$grpTipoFator" />
                     </children>
                  </HBox>

                  <Label text="Impacto (1 a 5):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Slider fx:id="sldImpacto" blockIncrement="1.0" majorTickUnit="1.0" max="5.0" min="1.0" minorTickCount="0" snapToTicks="true" value="3.0" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblValorImpacto" prefWidth="25.0" style="-fx-font-weight: bold;" text="3" />
                     </children>
                  </HBox>

                  <Label text="Probabilidade (1 a 5):" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="3" GridPane.rowIndex="1">
                     <children>
                        <Slider fx:id="sldProbabilidade" blockIncrement="1.0" majorTickUnit="1.0" max="5.0" min="1.0" minorTickCount="0" snapToTicks="true" value="3.0" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblValorProbabilidade" prefWidth="25.0" style="-fx-font-weight: bold;" text="3" />
                     </children>
                  </HBox>

                  <Label text="Descrição do Fator:*" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="txtDescricao" promptText="Ex.: Aumento na procura por produtos biológicos na região..." GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />

                  <Label text="Ação Sugerida:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <TextField fx:id="txtAcaoSugerida" promptText="Ex.: Desenvolver linha de embalagens certificadas para atender novos canais..." GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3" />
               </children>
            </GridPane>

            <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 5 0 0 0;">
               <children>
                  <Button onAction="#limparFormulario" prefHeight="30.0" prefWidth="100.0" text="Limpar" />
                  <Button onAction="#salvarFator" prefHeight="30.0" prefWidth="130.0" style="-fx-background-color: #2E5A44; -fx-text-fill: white; -fx-font-weight: bold;" text="Salvar Fator" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- VISUALIZAÇÃO COMPARATIVA: OPORTUNIDADES VS AMEAÇAS -->
      <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
         <items>
            <!-- COLUNA OPORTUNIDADES -->
            <VBox spacing="8.0" style="-fx-padding: 10; -fx-background-color: white;">
               <children>
                  <Label text="Oportunidades Identificadas" textFill="#2e7d32">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <TableView fx:id="tblOportunidades" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colOpDimensao" prefWidth="110.0" text="Dimensão" />
                      <TableColumn fx:id="colOpDescricao" prefWidth="230.0" text="Fator Observado" />
                      <TableColumn fx:id="colOpCriticidade" prefWidth="65.0" style="-fx-alignment: CENTER;" text="Relev." />
                      <TableColumn fx:id="colOpAcao" prefWidth="180.0" text="Estratégia Recomendada" />
                    </columns>
                    <columnResizePolicy>
                       <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                  </TableView>
                  <HBox alignment="CENTER_RIGHT" spacing="8.0">
                     <children>
                        <Button onAction="#editarOportunidadeSelecionada" text="Editar" />
                        <Button onAction="#excluirOportunidadeSelecionada" style="-fx-text-fill: #c62828;" text="Excluir" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- COLUNA AMEAÇAS -->
            <VBox spacing="8.0" style="-fx-padding: 10; -fx-background-radius: 6; -fx-background-color: white;">
               <children>
                  <Label text="Ameaças / Riscos Externos" textFill="#c62828">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <TableView fx:id="tblAmeacas" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colAmDimensao" prefWidth="110.0" text="Dimensão" />
                      <TableColumn fx:id="colAmDescricao" prefWidth="230.0" text="Risco Observado" />
                      <TableColumn fx:id="colAmCriticidade" prefWidth="65.0" style="-fx-alignment: CENTER;" text="Crit." />
                      <TableColumn fx:id="colAmAcao" prefWidth="180.0" text="Ação Preventiva / Mitigadora" />
                    </columns>
                    <columnResizePolicy>
                       <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                  </TableView>
                  <HBox alignment="CENTER_RIGHT" spacing="8.0">
                     <children>
                        <Button onAction="#editarAmeacaSelecionada" text="Editar" />
                        <Button onAction="#excluirAmeacaSelecionada" style="-fx-text-fill: #c62828;" text="Excluir" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </items>
      </SplitPane>

      <!-- RODAPÉ DE MENSAGENS -->
      <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 8 12; -fx-background-radius: 6;">
         <children>
            <Label fx:id="lblStatusMensagem" textFill="#2e7d32">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </children>
</VBox>