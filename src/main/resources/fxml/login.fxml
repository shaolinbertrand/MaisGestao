<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #F4F6F5; -fx-padding: 40;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestao.agro.controller.LoginController">
   <children>
      <Label text="Mais Gestão Rural" textFill="#1e3a2f">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label text="Identificação do Consultor de Campo" textFill="#555555">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      
      <VBox maxWidth="350.0" spacing="10.0" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);">
         <children>
            <Label text="Nome Completo do Consultor:*" />
            <TextField fx:id="txtNomeConsultor" prefHeight="35.0" promptText="Ex: Jean Bertrand" />
            
            <Label text="Matrícula / Identificação (Opcional):" />
            <TextField fx:id="txtMatricula" prefHeight="35.0" promptText="Ex: 2026-CONS-01" />
            
            <Label fx:id="lblErro" textFill="#d32f2f" wrapText="true">
               <font>
                  <Font size="11.0" />
               </font>
            </Label>
            
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#entrar" prefHeight="38.0" style="-fx-background-color: #2E5A44; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Acessar Sistema" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </VBox>
   </children>
</VBox>